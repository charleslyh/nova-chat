# Environment for `deploy/docker/docker-compose.yml`.
#
# Copy to `.env` and fill in. Every value here is a secret or an environment-
# specific setting: none of it belongs in a config file, which is why the TOML
# files reference variable *names* only (SEC-4).

# --- storage -----------------------------------------------------------------
# Local container password. In production this is a managed instance credential.
POSTGRES_PASSWORD=change-me

# IMPORTANT for production: the context store and the ledger share one database,
# and losing it means conversation history is gone permanently. Use a managed
# instance with a standby in a second availability zone plus periodic backups
# (D21 ①). A single container is for local use only.

# --- integrity ---------------------------------------------------------------
# HMAC key for stored-content tamper detection. At least 16 bytes.
# The service refuses to start if verification is enabled and this is unset,
# rather than storing records that could never be verified (INV-44).
NOVA_INTEGRITY_KEY=change-me-at-least-16-bytes

# --- node-to-node ------------------------------------------------------------
# Shared secret authenticating forwards between peers. Required whenever `peers`
# is configured: without it the internal tenant header would have to be trusted
# blindly, letting any client impersonate any tenant.
NOVA_INTERNAL_TOKEN=change-me

# --- callers -----------------------------------------------------------------
# `key:tenant` pairs, comma separated. Keys must be at least 8 characters.
NOVA_API_KEYS=example-key-1:tenant-a,example-key-2:tenant-b

# Guards the admin endpoints (read-only toggle, overload threshold, tenant purge).
NOVA_ADMIN_KEY=change-me

# --- observability -----------------------------------------------------------
RUST_LOG=info

# =============================================================================
# Deployment order: UPGRADE THE GATEWAY FIRST.
#
# The gateway validates every item type strictly (D22). If the execution side
# ships first and starts producing a type the gateway does not yet accept, the
# result is a spike of 400s. Rolling the gateway first widens the accepted set
# before anything can emit into it.
#
# Rolling restarts: send SIGTERM and allow the full grace period. The node stops
# accepting new work, drains what is in flight, then exits. Cutting this short
# discards every in-flight generation on that node — a single impatient deploy
# costs more than a month of unplanned crashes (D21).
# =============================================================================
